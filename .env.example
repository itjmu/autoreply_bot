# === Обязательно ===
BOT_TOKEN=1234567890:AAAA-example-token
ADMIN_IDS=111111111

# === AI ===
USE_AI=true
AI_TIMEOUT=40
AI_MAX_TOKENS=350
AI_PROVIDER_COOLDOWN=900
AI_PROVIDER_ORDER=openrouter,gemini,groq,deepseek,openai

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_MODEL=

# === Кастомные провайдеры (OpenAI-совместимые) ===
# CUSTOM1_NAME=
# CUSTOM1_API_KEY=
# CUSTOM1_BASE_URL=
# CUSTOM1_MODEL=

# === Поведение ===
AUTO_REPLY_DELAY=1.5
FAQ_MATCH_THRESHOLD=0.78

# === Пути (опционально) ===
# DB_PATH=/opt/autoreplybot/autoreply.db
