[Unit]
Description=AutoReply Telegram Business Bot (user mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замените ВАШ_ЛОГИН на ваш логин на сервере
WorkingDirectory=/home/ВАШ_ЛОГИН/autoreplybot
ExecStart=/home/ВАШ_ЛОГИН/autoreplybot/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
